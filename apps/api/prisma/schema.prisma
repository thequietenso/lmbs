generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Genre {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  books       Book[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Book {
  id              String    @id @default(cuid())
  title           String
  author          String
  isbn            String?   @unique
  genreId         Int
  genre           Genre     @relation(fields: [genreId], references: [id], onDelete: Restrict)
  pages           Int?
  publishedYear   Int?
  totalCopies     Int       @default(3)
  availableCopies Int       @default(3)
  shelfLocation   String?
  description     String?
  coverGradient   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  loans           Loan[]
  reviews         Review[]
  deletedAt       DateTime?

  @@index([genreId])
  @@index([title])
  @@index([deletedAt])
}

model Member {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  phone            String?
  membershipNumber String    @unique
  status           String    @default("active") // active | suspended | expired | inactive
  passwordHash     String?
  role             String    @default("patron")
  deletedAt        DateTime?
  joinedDate       DateTime  @default(now())
  bio              String?
  hobbies          String?
  loans            Loan[]
  reviews          Review[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, deletedAt])
}

model Loan {
  id           String    @id @default(cuid())
  bookId       String
  book         Book      @relation(fields: [bookId], references: [id], onDelete: Restrict)
  memberId     String
  member       Member    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  borrowDate   DateTime  @default(now())
  dueDate      DateTime
  returnDate   DateTime?
  status       String    @default("active") // active | returned | overdue
  fineAmount   Float?    @default(0)
  renewalCount Int       @default(0)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([memberId, status])
  @@index([bookId, returnDate])
  @@index([dueDate, returnDate])
}

model Activity {
  id          String   @id @default(cuid())
  actorId     String?
  entityId    String?
  type        String // borrow | return | add_book | update_book | delete_book | add_member | sync
  title       String
  description String
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([timestamp])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int // 1–5
  comment   String?
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Restrict)
  userId    String
  user      Member   @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookId, userId])
}

model IdempotencyRecord {
  id          String   @id
  requestHash String
  response    Json
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
