# Local development only: supply your own password/secret. Never commit .env.
DATABASE_URL=postgresql://lmbs:replace-with-local-password@localhost:5432/lmbs
PORT=3001
# Keep 0 for direct/native API access. Compose sets 1 behind its sole private proxy.
TRUST_PROXY_HOPS=0
NODE_ENV=development
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-bytes
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
SEED_DEMO_DATA=false
# Optional explicit bootstrap (both email and password required together):
# SEED_ADMIN_EMAIL=admin@example.test
# SEED_ADMIN_PASSWORD=use-a-unique-password-at-least-12-characters
# SEED_ADMIN_NAME=Library Administrator
# TEST_DATABASE_URL=postgresql://test:test@127.0.0.1:5432/lmbs_test
